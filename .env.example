# Nucleus website — environment template. Copy to .env and fill in.
# Full explanation of every var in project-docs/deployment.md.

# ── Database (Supabase Postgres) ────────────────────────────────────────────
# Runtime connection — Supabase transaction POOLER, port 6543.
DATABASE_URI=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres
# Migrations connection — Supabase DIRECT/session, port 5432.
DATABASE_URI_DIRECT=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# ── Payload ──────────────────────────────────────────────────────────────────
PAYLOAD_SECRET=generate-a-long-random-string

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=https://nucleusinternationalschoolsystem.com

# ── Media storage (Supabase Storage, S3-compatible) ──────────────────────────
# Leave all blank to use local-disk storage in dev.
S3_BUCKET=nucleus-media
S3_REGION=eu-central-1
S3_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Analytics ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=
